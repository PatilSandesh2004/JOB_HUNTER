# Copy to .env and fill in. Every value has a working default except GROQ_API_KEY.

# --- Access -----------------------------------------------------------------
# Shared secret for the API. Leave empty only while everything listens on localhost.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# --- AI service -------------------------------------------------------------
APP_NAME=JobPilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# SearXNG must have `json` in search.formats (see searxng/settings.yml)
SEARXNG_URL=http://localhost:8080

# Groq LLM: query expansion, resume extraction, cover letters, screening-answer suggestions.
# Without a key the app still works (heuristic parsing, template cover letters).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=["openai/gpt-oss-20b","qwen/qwen3.8-27b"]

# Storage (defaults to SQLite in ./data). PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://jobpilot:<password>@localhost:5432/jobpilot_db

# Browser agent: set false to watch Chromium fill forms
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENCY=2

# Background agent tasks: attempts for a form fill before giving up (submits are never retried)
TASK_MAX_ATTEMPTS=3
# Re-check stored jobs with the job board every N hours and mark closed postings (0 disables)
JOB_RECHECK_INTERVAL_HOURS=12

# Job sites read from search results (their postings are "Apply manually"). [] turns this off.
# SEARCH_JOB_SITES=["linkedin.com/jobs/view","naukri.com","indeed.com"]
# Google results through Serper.dev instead of SearXNG:
# WEB_SEARCH_PROVIDER=serper
# SERPER_API_KEY=

# Adzuna job search API (covers India, with salaries). Free key at developer.adzuna.com. Empty: off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Job feeds (cached; set false to skip one)
# SEARCH_ENABLE_REMOTIVE=true
# SEARCH_ENABLE_REMOTEOK=true
# SEARCH_ENABLE_HIMALAYAS=true
# SEARCH_ENABLE_JOBICY=true
# SEARCH_ENABLE_ARBEITNOW=true

# Matching: resume-to-description similarity with a local model (downloaded once, ~65 MB), and an AI
# review of the top results of each search (needs GROQ_API_KEY; 0 turns it off).
# SEMANTIC_MATCHING=true
# LLM_REVIEW_TOP_N=20

# HTTPS certificate checks. Behind a company proxy with its own certificate, point CA_BUNDLE at it.
# CA_BUNDLE=C:\path\to\proxy-ca.pem
# TLS_VERIFY=true

# Job-alert inbox (optional): adds jobs from your LinkedIn / Indeed / Naukri alert emails and moves
# applications forward when companies reply. Read-only. Gmail: turn on 2-step verification, then create
# an app password (Google Account -> Security -> App passwords) and put it below.
IMAP_USER=
IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_FOLDER=INBOX
# INBOX_CHECK_INTERVAL_MINUTES=30
# INBOX_UPDATE_STATUSES=true

# Run your profile's search automatically every N hours (0 = off)
DISCOVERY_INTERVAL_HOURS=0

# Optional Slack/Discord incoming webhook for matches above the threshold (each job is announced once)
NOTIFICATION_WEBHOOK_URL=
HIGH_MATCH_THRESHOLD=85

# Optional SMTP for email alerts and reports (Gmail: smtp.gmail.com, port 587, an app password).
# Sent to ALERT_EMAIL_TO, or to SMTP_USER when that is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@jobpilot.local
ALERT_EMAIL_TO=
# Digest of new good matches every N hours (0 = off), and a weekly progress report
ALERT_DIGEST_HOURS=0
WEEKLY_REPORT_EMAIL=false

# Full Auto-Pilot (profile setting): at most this many automatic applications per 24 hours
AUTO_APPLY_DAILY_LIMIT=5
# Flag applications with no news for this many days so you can follow up (0 = off)
FOLLOW_UP_DAYS=7

# --- Go gateway -------------------------------------------------------------
# BIND_ADDR=127.0.0.1
# PORT=8090
# AI_SERVICE_URL=http://localhost:8000

# --- Docker compose only ----------------------------------------------------
POSTGRES_PASSWORD=
SEARXNG_SECRET=
